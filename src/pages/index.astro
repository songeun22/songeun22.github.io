---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Reveal from '../components/Reveal.astro';
import SocialLinks from '../components/SocialLinks.astro';
import BookCover from '../components/BookCover.astro';
import { site } from '../site.config';
import { getShelf } from '../lib/library';
import { existsSync } from 'node:fs';
import { join } from 'node:path';

// Home doubles as the About page: who I am, then publications, experience,
// and what I'm writing.

const timeline = (await getCollection('timeline')).sort((a, b) => b.data.start - a.data.start);

const books = (await getShelf()).filter((item) => !item.planned);

/**
 * Newest first. `me` is my index in `authors`. Long author lists collapse to
 * first two, me, and the last author, with a toggle for the rest.
 */
const publications = [
  {
    title: 'Retiming Robot Demonstrations with a Learned Speed Prior',
    authors: [
      'Seungyong Moon', 'Deokjae Lee', 'Hansang Lee', 'Munkhtselmeg Battsengel', 'Youngin Kim',
      'Seonghyeon Yun', 'Sungjin Jeon', 'SongEun Kim', 'Jeongmin Park', 'Hyun Oh Song',
    ],
    me: 7,
    venue: 'Under review',
  },
  {
    title: 'From Drift to Coherence: Stabilizing Beliefs of LLMs',
    authors: ['SongEun Kim', 'Seungyoo Lee', 'Edwin Fong', 'Hyungi Lee', 'Juho Lee'],
    me: 0,
    venue: 'ICML 2026',
    link: { label: 'arXiv', href: 'https://arxiv.org/abs/2606.17832' },
  },
];

const COLLAPSE_AT = 6;
const shortList = (authors: string[], me: number) => {
  const keep = [...new Set([0, 1, me, authors.length - 1])].sort((a, b) => a - b);
  const out: (number | null)[] = [];
  keep.forEach((k, i) => {
    if (i > 0 && k - keep[i - 1] > 1) out.push(null);
    out.push(k);
  });
  return out;
};

// Work on the left of the rail, research and education on the right.
const side = (kind: string) => (kind === 'work' ? 'left' : 'right');

// Real photo on the front, memoji on the back. Until the photo exists in
// /public, show the memoji alone and skip the flip.
const hasPhoto = existsSync(join(process.cwd(), 'public', site.photo));
---

<Base>
  <!-- Profile + bio -->
  <section class="hero">
    <Reveal class="profile">
      {hasPhoto ? (
        <button type="button" class="flip" aria-label="Flip profile picture">
          <span class="flip-inner">
            <img class="face front" src={`/${site.photo}`} alt={`Photo of ${site.name}`} width="200" height="200" />
            <img class="face back" src={site.avatar} alt="" width="200" height="200" />
          </span>
        </button>
      ) : (
        <img class="avatar" src={site.avatar} alt="" width="200" height="200" />
      )}
      <h1><span class="first">Songeun</span> <span class="last">Kim</span></h1>
      <p class="tagline">{site.tagline}</p>
      <p class="intro">
        Hello, I'm <span class="nowrap">Songeun Kim (김송은)</span> — or you can just call me Olivia.
        Welcome to my personal blog!
      </p>
      <SocialLinks />
      <div class="cta">
        <a class="btn primary" href="/cv">CV</a>
        <a class="btn" href="/library">Library</a>
      </div>
    </Reveal>

    <Reveal delay={100} class="bio">
      <div class="prose">
        <p>I am an undergraduate researcher majoring in Statistics at Seoul National University.</p>
        <p>
          My research interests center on{' '}
          <strong class="key">robust decision-making under uncertainty, grounded in statistical theory</strong>.
          I am particularly interested in understanding uncertainty in machine learning systems and
          developing principled methods to control risk and enable reliable decisions, with the
          broader goal of building trustworthy AI.
        </p>
      </div>
    </Reveal>
  </section>

  <!-- Publications -->
  <section class="block">
    <Reveal>
      <div class="block-head"><h2>Publications</h2></div>
    </Reveal>

    <ol class="pub-list">
      {
        publications.map((pub) => {
          const collapse = pub.authors.length > COLLAPSE_AT;
          const name = (i: number) => (i === pub.me ? <strong>{pub.authors[i]}</strong> : pub.authors[i]);
          return (
            <li>
              <Reveal>
                <p class="pub-title">{pub.title}</p>
                <p class="pub-authors">
                  {collapse ? (
                    <>
                      <span class="authors-short">
                        {shortList(pub.authors, pub.me).map((k, i) => (
                          <>
                            {i > 0 && ', '}
                            {k === null ? '…' : name(k)}
                          </>
                        ))}
                      </span>
                      <span class="authors-full" hidden>
                        {pub.authors.map((_, i) => (
                          <>
                            {i > 0 && ', '}
                            {name(i)}
                          </>
                        ))}
                      </span>{' '}
                      <button type="button" class="authors-toggle" aria-expanded="false">
                        see all
                      </button>
                    </>
                  ) : (
                    pub.authors.map((_, i) => (
                      <>
                        {i > 0 && ', '}
                        {name(i)}
                      </>
                    ))
                  )}
                </p>
                <p class="pub-meta">
                  {pub.venue}
                  {pub.link && (
                    <>
                      {' · '}
                      <a href={pub.link.href}>{pub.link.label}</a>
                    </>
                  )}
                </p>
              </Reveal>
            </li>
          );
        })
      }
    </ol>
  </section>

  <!-- Experience -->
  <section class="block">
    <Reveal>
      <div class="block-head"><h2>Experience</h2></div>
    </Reveal>

    <div class="tl-legend" aria-hidden="true">
      <span>Work</span>
      <span>Research</span>
    </div>

    <ol class="timeline">
      {
        timeline.map((entry, i) => (
          <li class={side(entry.data.kind)}>
            <span class="dot" data-kind={entry.data.kind} />
            <Reveal delay={i * 90} class="tl-card">
              <p class="period">{entry.data.period}</p>
              <h3>{entry.data.org}</h3>
              <p class="org">{entry.data.title}</p>
              {entry.data.description && <p class="desc">{entry.data.description}</p>}
            </Reveal>
          </li>
        ))
      }
    </ol>
  </section>

  <!-- Library -->
  <section class="block">
    <Reveal>
      <div class="block-head">
        <h2>Library</h2>
        <a class="more" href="/library">See the shelf →</a>
      </div>
    </Reveal>

    <ul class="books">
      {
        books.map((item) => (
          <li>
            <Reveal class="book-row">
              <BookCover item={item} />
              <div class="book-text">
                <h3 class="display">
                  {item.href ? <a href={item.href}>{item.book.data.title}</a> : item.book.data.title}
                </h3>
                {item.book.data.subtitle && <p class="book-sub">{item.book.data.subtitle}</p>}
                {item.book.data.description && <p class="book-desc">{item.book.data.description}</p>}
              </div>
            </Reveal>
          </li>
        ))
      }
    </ul>
  </section>

</Base>

<script>
  for (const btn of document.querySelectorAll<HTMLButtonElement>('.authors-toggle')) {
    btn.addEventListener('click', () => {
      const p = btn.closest('.pub-authors')!;
      const open = btn.getAttribute('aria-expanded') === 'true';
      p.querySelector<HTMLElement>('.authors-short')!.hidden = !open;
      p.querySelector<HTMLElement>('.authors-full')!.hidden = open;
      btn.setAttribute('aria-expanded', String(!open));
      btn.textContent = open ? btn.dataset.label! : 'show fewer';
    });
    btn.dataset.label = btn.textContent!.trim();
  }

  // Touch screens have no hover: a tap flips the card instead.
  if (!matchMedia('(hover: hover)').matches) {
    document.querySelector('.flip')?.addEventListener('click', (e) => {
      (e.currentTarget as HTMLElement).classList.toggle('flipped');
    });
  }
</script>

<style>
  /* Home reads narrower than the rest of the site: 0.8x the page width.
     Set on the root so the nav lines up with the content too. This style
     only ships with the home page. */
  :global(html:root) {
    --page-max: 960px;
  }

  /* ---- Profile + bio ---- */

  .hero {
    display: grid;
    grid-template-columns: 300px minmax(0, 1fr);
    gap: var(--space-16);
    /* Bio sits at the vertical middle of the profile column. */
    align-items: center;
    padding-block: var(--space-16) var(--space-12);
  }

  .hero :global(.profile) {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-3);
  }

  .avatar {
    width: 200px;
    height: 200px;
    margin-bottom: var(--space-2);
    border-radius: 50%;
    background: var(--bg-subtle);
    border: 1px solid var(--border);
  }

  .hero h1 {
    font-size: var(--text-4xl);
    line-height: 1.05;
  }

  /* Light first name, heavy surname. */
  .first {
    font-weight: var(--weight-light);
  }

  .last {
    font-weight: 800;
  }

  .tagline {
    margin-top: calc(-1 * var(--space-2));
    font-size: var(--text-lg);
    color: var(--text-faint);
  }

  .intro {
    font-family: var(--font-sans);
    line-height: var(--leading-snug);
    color: var(--text-muted);
  }

  .nowrap {
    white-space: nowrap;
  }

  .hero :global(.socials) {
    justify-content: flex-start;
    margin-top: var(--space-2);
  }

  .cta {
    display: flex;
    gap: var(--space-3);
    flex-wrap: wrap;
    margin-top: var(--space-2);
  }

  .btn {
    display: inline-block;
    padding: var(--space-2) var(--space-6);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    color: var(--text);
    background: transparent;
    border: 1px solid var(--border-strong);
    border-radius: 999px;
    text-decoration: none;
  }

  .btn:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .btn.primary {
    background: var(--accent-fill);
    border-color: var(--accent-fill);
    color: #fff;
  }

  .btn.primary:hover {
    background: color-mix(in srgb, var(--accent-fill) 85%, black);
    border-color: color-mix(in srgb, var(--accent-fill) 85%, black);
    color: #fff;
  }

  /* ---- Flip card: photo front, memoji back ---- */

  .flip {
    width: 200px;
    height: 200px;
    margin-bottom: var(--space-2);
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: none;
    perspective: 800px;
    cursor: pointer;
  }

  .flip-inner {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    transform-style: preserve-3d;
    transition: transform 0.7s var(--ease);
  }

  .flip:focus-visible .flip-inner,
  .flip.flipped .flip-inner {
    transform: rotateY(180deg);
  }

  /* Hover only where hover is real. On touch screens :hover sticks after a
     tap, which would keep the card flipped; there a tap toggles instead. */
  @media (hover: hover) {
    .flip:hover .flip-inner {
      transform: rotateY(180deg);
    }
  }

  .face {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 50%;
    border: 1px solid var(--border);
    background: var(--bg-subtle);
    -webkit-backface-visibility: hidden;
    backface-visibility: hidden;
  }

  .face.back {
    transform: rotateY(180deg);
  }

  /* Highlighted research keywords in the bio. */
  .key {
    color: var(--accent);
    font-weight: var(--weight-semibold);
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--accent) 45%, transparent);
    text-decoration-thickness: 1.5px;
    text-underline-offset: 0.22em;
  }

  .hero :global(.bio .prose) {
    max-width: none;
  }

  /* ---- Sections ---- */

  .block {
    padding-bottom: var(--space-16);
  }

  .block-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-4);
    padding-bottom: var(--space-6);
    margin-bottom: var(--space-8);
    border-bottom: 1px solid var(--border);
  }

  .block-head h2 {
    font-size: var(--text-2xl);
    font-weight: var(--weight-bold);
  }

  .more {
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    text-decoration: none;
    white-space: nowrap;
  }

  /* ---- Publications ---- */

  .pub-list {
    list-style: none;
    padding: 0;
    margin: 0;
    max-width: 760px;
  }

  .pub-list li + li {
    margin-top: var(--space-6);
  }

  .pub-authors {
    margin-top: var(--space-1);
    font-size: var(--text-sm);
    color: var(--text-muted);
  }

  .pub-title {
    font-family: var(--font-sans);
    font-size: var(--text-lg);
  }

  .authors-toggle {
    padding: 0;
    border: 0;
    background: none;
    font-size: var(--text-xs);
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .pub-meta {
    margin-top: var(--space-1);
    font-size: var(--text-sm);
    color: var(--text-faint);
  }

  /* ---- Experience: centre rail, work left, research right ---- */

  .tl-legend {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-16);
    margin-bottom: var(--space-4);
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-faint);
  }

  .tl-legend span:first-child {
    text-align: right;
  }

  .timeline {
    position: relative;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .timeline::before {
    content: '';
    position: absolute;
    top: 6px;
    bottom: 6px;
    left: 50%;
    width: 3px;
    transform: translateX(-50%);
    border-radius: 2px;
    background: color-mix(in srgb, var(--accent-fill) 35%, var(--border));
  }

  .timeline li {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-16);
  }

  .timeline li + li {
    margin-top: var(--space-6);
  }

  .timeline li.left :global(.tl-card) {
    grid-column: 1;
    text-align: right;
  }

  .timeline li.right :global(.tl-card) {
    grid-column: 2;
  }

  .dot {
    position: absolute;
    top: 4px;
    left: 50%;
    z-index: 1;
    width: 18px;
    height: 18px;
    transform: translateX(-50%);
    border-radius: 50%;
    background: var(--bg);
    border: 3px solid var(--accent-fill);
  }

  .dot[data-kind='research'] {
    background: var(--accent-fill);
    box-shadow: 0 0 0 4px var(--accent-subtle);
  }

  .period {
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    letter-spacing: 0.02em;
    color: var(--accent);
  }

  .timeline h3 {
    margin-top: var(--space-1);
    font-size: var(--text-lg);
  }

  .org {
    margin-top: 2px;
    color: var(--text-muted);
  }

  .desc {
    margin-top: var(--space-1);
    font-size: var(--text-sm);
    line-height: var(--leading-snug);
    color: var(--text-faint);
  }

  /* ---- Library ---- */

  .books {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .books > li + li {
    margin-top: var(--space-12);
    padding-top: var(--space-12);
    border-top: 1px solid var(--border);
  }

  .books :global(.book-row) {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: var(--space-12);
    align-items: center;
  }

  /* Same size as the experience titles above. */
  .book-text h3 {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: var(--weight-bold);
  }

  .book-text h3 a {
    color: inherit;
    text-decoration: none;
  }

  .book-text h3 a:hover {
    color: var(--accent);
  }

  .book-sub {
    margin-top: var(--space-1);
    color: var(--text-faint);
  }

  .book-desc {
    margin-top: var(--space-4);
    max-width: 62ch;
    font-family: var(--font-sans);
    line-height: var(--leading-normal);
    color: var(--text-muted);
  }

  @media (max-width: 860px) {
    .hero {
      grid-template-columns: 1fr;
      gap: var(--space-8);
      padding-block: var(--space-12) var(--space-8);
    }
  }

  @media (max-width: 640px) {
    .tl-legend {
      display: none;
    }
    .timeline::before {
      left: 9px;
    }
    .timeline li {
      grid-template-columns: 1fr;
      padding-left: var(--space-8);
    }
    .timeline li.left :global(.tl-card),
    .timeline li.right :global(.tl-card) {
      grid-column: 1;
      text-align: left;
    }
    .dot {
      left: 9px;
    }

    .books :global(.book-row) {
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }
  }
</style>
