---
import type { ShelfItem } from '../lib/library';

/**
 * A light, flat book cover: a pale tint of the book's colour, a solid spine
 * stripe on the left, and the title set in that colour. Lifts a little on
 * hover.
 */
interface Props {
  item: ShelfItem;
}

const { item } = Astro.props;
const d = item.book.data;
const Tag = item.href ? 'a' : 'div';
---

<Tag class="book-cover" href={item.href ?? undefined} aria-label={d.title} style={`--color: ${d.color};`}>
  <span class="title">{d.title}</span>
  {d.subtitle && <span class="sub">{d.subtitle}</span>}
  <span class="mark" aria-hidden="true"></span>
</Tag>

<style>
  .book-cover {
    --tint: color-mix(in srgb, var(--color) 13%, var(--surface));
    --ink: color-mix(in srgb, var(--color) 78%, black);

    position: relative;
    display: flex;
    flex-direction: column;
    width: 132px;
    aspect-ratio: 3 / 4.2;
    padding: var(--space-4) var(--space-3) var(--space-4) calc(var(--space-3) + 8px);
    background: var(--tint);
    border: 1px solid color-mix(in srgb, var(--color) 22%, transparent);
    border-radius: 0;
    box-shadow:
      0 1px 2px rgb(0 0 0 / 0.04),
      0 6px 16px rgb(0 0 0 / 0.05);
    text-decoration: none;
    overflow: hidden;
    transition:
      transform 0.35s var(--ease),
      box-shadow 0.35s var(--ease);
  }

  :global(:root[data-theme='dark']) .book-cover {
    --tint: color-mix(in srgb, var(--color) 22%, var(--surface));
    --ink: color-mix(in srgb, var(--color) 45%, white);
  }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .book-cover {
      --tint: color-mix(in srgb, var(--color) 22%, var(--surface));
      --ink: color-mix(in srgb, var(--color) 45%, white);
    }
  }

  .book-cover:hover,
  .book-cover:focus-visible {
    transform: translateY(-4px);
    box-shadow:
      0 2px 4px rgb(0 0 0 / 0.05),
      0 14px 28px rgb(0 0 0 / 0.08);
  }

  /* Spine stripe. */
  .book-cover::before {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    width: 6px;
    background: var(--color);
  }

  .title {
    font-family: var(--font-display);
    font-palette: --mint;
    font-size: var(--text-base);
    font-weight: var(--weight-bold);
    line-height: var(--leading-tight);
    color: var(--ink);
  }

  .sub {
    margin-top: var(--space-2);
    font-size: 11px;
    line-height: var(--leading-snug);
    color: var(--text-muted);
  }

  /* A small mark in the book's colour, anchored to the bottom. */
  .mark {
    margin-top: auto;
    width: 18px;
    height: 3px;
    border-radius: 0;
    background: var(--color);
  }

  @media (prefers-reduced-motion: reduce) {
    .book-cover {
      transition: none;
    }
  }
</style>
